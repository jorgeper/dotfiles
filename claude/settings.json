{
  "agentPushNotifEnabled" : true,
  "enabledPlugins" : {
    "claude-md-management@claude-plugins-official" : true,
    "code-review@claude-plugins-official" : true,
    "context7@claude-plugins-official" : true,
    "frontend-design@claude-plugins-official" : true,
    "github@claude-plugins-official" : true,
    "mattpocock-skills@mattpocock" : true,
    "playwright@claude-plugins-official" : true,
    "superpowers@claude-plugins-official" : true
  },
  "extraKnownMarketplaces" : {
    "mattpocock" : {
      "source" : {
        "repo" : "mattpocock\/skills",
        "source" : "github"
      }
    },
    "sandbox-plugins" : {
      "source" : {
        "path" : "\/Users\/jorgeper\/src\/sandbox\/plugins",
        "source" : "directory"
      }
    }
  },
  "hooks" : {
    "ConfigChange" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/settings-guard.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm-tab.sh waiting",
            "type" : "command"
          }
        ],
        "matcher" : "permission_prompt|elicitation_dialog"
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm-tab.sh working",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUseFailure" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm-tab.sh working",
            "type" : "command"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm-tab.sh waiting",
            "type" : "command"
          }
        ],
        "matcher" : "AskUserQuestion"
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm-tab.sh off",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm-tab.sh alive",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/settings-guard.sh",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm-tab.sh idle",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "StopFailure" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "SubagentStop" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm-tab.sh working",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/jorgeper\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "model" : "opus",
  "modelSettings" : {
    "claude-opus-5" : {
      "effortLevel" : "high"
    },
    "claude-opus-5-5" : {
      "autoCompactWindow" : 400000,
      "effortLevel" : "high"
    }
  },
  "skipDangerousModePermissionPrompt" : true,
  "statusLine" : {
    "command" : "bash ~\/.claude\/statusline-command.sh",
    "type" : "command"
  },
  "theme" : "dark",
  "tui" : "fullscreen"
}